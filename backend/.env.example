DATABASE_URL="mysql://usuario:senha@localhost:3306/lace_db"
# Railway MySQL also exposes MYSQL_URL. The backend accepts either DATABASE_URL or MYSQL_URL.
# MYSQL_URL="mysql://usuario:senha@host:3306/railway"
# MySQL local habilita isto automaticamente. Em outro host, use apenas em uma rede confiavel.
# DATABASE_ALLOW_PUBLIC_KEY_RETRIEVAL=true
JWT_SECRET="substitua-por-um-segredo-longo-e-aleatorio"
FRONTEND_URL="http://localhost:5174"
# Use comma-separated values when you need multiple production origins.
# FRONTEND_URLS="https://lablace.com.br,https://www.lablace.com.br"
PORT=3000
NODE_ENV="development"

COORDINATOR_1_NAME="Joana"
COORDINATOR_1_EMAIL="coordenacao1@example.org"
COORDINATOR_1_PASSWORD="defina-uma-senha-segura"
